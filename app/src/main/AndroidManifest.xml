<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.github.tvbox.osc">

    <!-- 强制忽略 Crosswalk(API 19) 以及其他所有子库的最低版本限制 -->
    <uses-sdk
        tools:overrideLibrary="org.xwalk.core, com.google.android.exoplayer2, com.whl.quickjs.android, androidx.room, okhttp3, com.kingja.loadsir, com.orhanobut.hawk, xyz.doikki.videoplayer, tv.danmaku.ijk.media" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name="com.github.tvbox.osc.base.App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:banner="@drawable/app_banner"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup,android:label"
        tools:targetApi="jelly_bean_mr1">

        <activity
            android:name="com.github.tvbox.osc.ui.activity.HomeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.github.tvbox.osc.ui.activity.DetailActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.LivePlayActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.FastSearchActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.SettingActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.CollectActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.HistoryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.PushActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.SearchActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name="com.github.tvbox.osc.ui.activity.LocalFileActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="sensorLandscape" />

        <!-- 播放与投屏服务 -->
        <service android:name="com.github.tvbox.osc.dlna.DLNACastService" />
        <service android:name="com.github.tvbox.osc.player.MusicPlaybackService" />

        <!-- 广播接收器 -->
        <receiver android:name="com.github.tvbox.osc.receiver.CustomWebReceiver" />
        <receiver android:name="com.github.tvbox.osc.receiver.PushReceiver" />
        <receiver android:name="com.github.tvbox.osc.receiver.SearchReceiver" />

        <!-- 文件共享 Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
