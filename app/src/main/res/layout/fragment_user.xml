<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部导航快捷入口栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vs_20"
        android:paddingTop="@dimen/vs_15"
        android:paddingEnd="@dimen/vs_20"
        android:paddingBottom="@dimen/vs_10">

        <!-- 历史记录 (LinearLayout 保证与 UserFragment.java:160 类型完全一致) -->
        <LinearLayout
            android:id="@+id/tvHistory"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_15"
            android:paddingEnd="@dimen/vs_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <!-- 收藏 -->
        <LinearLayout
            android:id="@+id/tvFavorite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_15"
            android:paddingEnd="@dimen/vs_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <!-- 推送 -->
        <LinearLayout
            android:id="@+id/tvPush"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_15"
            android:paddingEnd="@dimen/vs_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推送"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <!-- 设置 -->
        <LinearLayout
            android:id="@+id/tvSetting"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_15"
            android:paddingEnd="@dimen/vs_15">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <!-- 直播 -->
        <LinearLayout
            android:id="@+id/tvLive"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_40"
            android:layout_marginEnd="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vs_15"
            android:paddingEnd="@dimen/vs_15"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直播"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>

    <!-- 推荐/热播列表标题 -->
    <TextView
        android:id="@+id/tvHotList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/vs_20"
        android:paddingTop="@dimen/vs_5"
        android:paddingBottom="@dimen/vs_5"
        android:text="热门推荐"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_18" />

    <!-- 底部网格数据流 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/vs_20"
        android:paddingEnd="@dimen/vs_20" />

</LinearLayout>
