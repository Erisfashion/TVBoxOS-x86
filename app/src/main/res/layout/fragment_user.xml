<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_40">

    <!-- 顶部 6 个核心交互模块（历史、直播、搜索、推送、收藏、设置） -->
    <LinearLayout
        android:id="@+id/tvUserHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="horizontal">

        <!-- 历史 -->
        <LinearLayout
            android:id="@+id/tvHistory"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:alpha="0.85"
                app:srcCompat="@drawable/icon_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="false"
                android:gravity="center"
                android:text="历史"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 直播 -->
        <LinearLayout
            android:id="@+id/tvLive"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:alpha="0.85"
                app:srcCompat="@drawable/icon_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="false"
                android:gravity="center"
                android:text="直播"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 搜索 -->
        <LinearLayout
            android:id="@+id/tvSearch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:alpha="0.85"
                app:srcCompat="@drawable/icon_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="false"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 推送 -->
        <LinearLayout
            android:id="@+id/tvPush"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:alpha="0.85"
                app:srcCompat="@drawable/icon_push" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="false"
                android:gravity="center"
                android:text="推送"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 收藏 -->
        <LinearLayout
            android:id="@+id/tvFavorite"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/vs_15"
            android:layout_marginRight="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:alpha="0.85"
                app:srcCompat="@drawable/icon_collect" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="false"
                android:gravity="center"
                android:text="收藏"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>

        <!-- 设置 -->
        <LinearLayout
            android:id="@+id/tvSetting"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_100"
            android:layout_gravity="center_vertical"
            android:background="@drawable/shape_user_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15">

            <ImageView
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:layout_gravity="center"
                android:alpha="0.85"
                app:srcCompat="@drawable/icon_setting" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:focusable="false"
                android:gravity="center"
                android:text="设置"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_30" />
        </LinearLayout>
    </LinearLayout>

    <!-- 下方推荐列表 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_15"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
